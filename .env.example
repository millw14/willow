# ── One Wish Willow environment ──
# Everything below is OPTIONAL. With no keys the site runs in "candlelight mode":
# wishes are kept in server memory, prophecies come from the offline oracle,
# and a curated set of fallback wishes fills the archive.

# Supabase (persistent wishes + one-wish-per-wallet enforcement)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role is used server-side only for trusted writes (never exposed to client)
SUPABASE_SERVICE_ROLE_KEY=

# Groq (the Keeper of Wishes)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Solana RPC (defaults to mainnet-beta public endpoint)
# A private RPC (Helius/QuickNode/Triton) is strongly recommended for mainnet —
# the public endpoint rate-limits payment verification and buy-and-burn.
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
# Optional separate server-side RPC (falls back to NEXT_PUBLIC_SOLANA_RPC)
SOLANA_RPC=

# ── Paid wishes + buy-and-burn (OPTIONAL) ──
# Leave TREASURY_SECRET_KEY empty to keep wishes free (no payment gate).
# When set, each wish costs WISH_PRICE_USDC, paid to the treasury's address
# (derived from this key). Accept base58 OR a JSON byte array. SERVER-ONLY —
# never prefix with NEXT_PUBLIC and never commit a funded key.
TREASURY_SECRET_KEY=
# Price per wish in USD (charged as USDC, or the live SOL-equivalent)
WISH_PRICE_USDC=6.99
# Which currencies a seeker may pay with: usdc | sol | both
WISH_CURRENCY=both
# Jupiter Price API for live SOL/USD (defaults to the free lite endpoint)
JUPITER_PRICE_URL=https://lite-api.jup.ag/price/v3
# Token that gets bought & burned (defaults to the willow token)
WISH_TOKEN_MINT=2VkpEcZ7zUVWZ8RUPuhKjaARw2vPUnhV2dcmco7spump
# Buy & burn every N paid wishes
BURN_EVERY=3
# Fraction of treasury USDC to keep back for fees on each burn (0.10 = 10%)
FEE_RESERVE_RATIO=0.10
# USDC mint override (defaults to mainnet USDC)
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Jupiter swap API (defaults to the free lite endpoint). For api.jup.ag set a key.
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=
JUP_SLIPPAGE_BPS=500
# Protects POST /api/buyburn so only your cron/operator can flush a burn
CRON_SECRET=

# Oracle phone line (display only for now)
NEXT_PUBLIC_ORACLE_PHONE=+1 (888) 947-4569

# ── Oracle voice line (stretch: Twilio + ElevenLabs) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
