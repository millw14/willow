# ── One Wish Willow environment ──
# Everything below is OPTIONAL. With no keys the site runs in "candlelight mode":
# wishes are kept in server memory, prophecies come from the offline oracle,
# and a curated set of fallback wishes fills the archive.

# Supabase (persistent wishes + one-wish-per-wallet enforcement)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role is used server-side only for trusted writes (never exposed to client)
SUPABASE_SERVICE_ROLE_KEY=

# Groq (the Keeper of Wishes)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Solana RPC (defaults to mainnet-beta public endpoint)
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# Oracle phone line (display only for now)
NEXT_PUBLIC_ORACLE_PHONE=+1 (888) 947-4569

# ── Oracle voice line (stretch: Twilio + ElevenLabs) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
